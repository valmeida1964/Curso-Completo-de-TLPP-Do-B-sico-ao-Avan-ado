namespace curso.academico

// Funcao principal do exemplo
user function OlaTlpp()

    Local cNome := "Aluno"

    ConOut("================================")
    ConOut("CURSO COMPLETO DE TLPP")
    ConOut("Ola, " + cNome)
    ConOut("Primeiro programa TLPP executado!")
    ConOut("================================")

return
