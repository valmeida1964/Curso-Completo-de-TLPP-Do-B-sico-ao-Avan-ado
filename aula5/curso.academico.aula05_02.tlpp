
#include "tlpp-core.th"

namespace curso.academico

user function Aula0502()

    Local aAlunos := { ;
        {"000001", "Carlos Silva", {8, 7, 9}}, ;
        {"000002", "Maria Oliveira", {5, 6, 7}}, ;
        {"000003", "Joao Santos", {9, 9, 10}} }

    Local nPos := 0

    nPos := BuscaAl05(aAlunos, "000003")

    If nPos > 0
        ConOut("Encontrado: " + aAlunos[nPos][2])
    Else
        ConOut("Aluno nao encontrado.")
    EndIf

return

/*
    Pesquisa um aluno pela matricula.

    Retorno:
    Posicao do aluno ou zero.
*/
static function BuscaAl05(aAlunos, cMatricula)

    Local nPos := 0

    nPos := AScan(aAlunos, ;
        {|aAluno| aAluno[1] == cMatricula})

return nPos
