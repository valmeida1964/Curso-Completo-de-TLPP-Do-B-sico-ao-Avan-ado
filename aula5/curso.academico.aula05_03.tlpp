
#include "tlpp-core.th"

namespace curso.academico

user function Aula0503()

    Local aAlunos := { ;
        {"000001", "Carlos Silva", {8, 7, 9}}, ;
        {"000002", "Maria Oliveira", {5, 6, 7}}, ;
        {"000003", "Joao Santos", {9, 9, 10}}, ;
        {"000004", "Ana Souza", {7, 7, 7}} }

    Local nI := 0

    ConOut("ANTES DA ORDENACAO")

    For nI := 1 To Len(aAlunos)
        ConOut(aAlunos[nI][2])
    Next nI

    /*
        Ordena pelo nome.
    */
    ASort(aAlunos, , , ;
        {|a, b| Upper(a[2]) < Upper(b[2])})

    ConOut("DEPOIS DA ORDENACAO")

    For nI := 1 To Len(aAlunos)
        ConOut(aAlunos[nI][2])
    Next nI

return
