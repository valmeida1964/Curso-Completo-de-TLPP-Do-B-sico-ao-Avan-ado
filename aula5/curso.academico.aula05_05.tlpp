
#include "tlpp-core.th"

namespace curso.academico

user function Aula0505()

    Local aAlunos := { ;
        {"000001", "Carlos Silva", {8, 7, 9}}, ;
        {"000002", "Maria Oliveira", {5, 6, 7}}, ;
        {"000003", "Joao Santos", {9, 9, 10}} }

    Local cMatricula := "000002"
    Local nPos := 0
    Local nI := 0

    nPos := AScan(aAlunos, ;
        {|aAluno| aAluno[1] == cMatricula})

    If nPos > 0

        ADel(aAlunos, nPos)

        ASize(aAlunos, Len(aAlunos) - 1)

        ConOut("Aluno excluido.")

    Else

        ConOut("Aluno nao encontrado.")

    EndIf

    For nI := 1 To Len(aAlunos)

        ConOut(aAlunos[nI][1] + " - " + ;
            aAlunos[nI][2])

    Next nI

return
